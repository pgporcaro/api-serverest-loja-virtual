			"name": "Buscar produto por ID",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{url}}/produtos/{{_id}}?_id=&nome=&preco=&descricao=&quantidade=",
					"host": [
						"{{url}}"
					],
					"path": [
						"produtos",
						"{{_id}}"
					],
					"query": [
						{
							"key": "_id",
							"value": ""
