		{
			"name": "Login Usuário",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Gera um e-mail aleatório com base no timestamp\r",
							"const randomEmail = `usuario_${Date.now()}@teste.com`;\r",
							"\r",
							"// Armazena na variável de ambiente ou global\r",
							"pm.environment.set(\"email_aleatorio\", randomEmail);\r",
							"\r",
							"// Gera um nome de usuário simples\r",
							"const nomes = [\"ana\", \"carlos\", \"beatriz\", \"eduardo\", \"fernanda\", \"joao\", \"luciana\", \"marcelo\"];\r",
							"const sobrenomes = [\"silva\", \"souza\", \"oliveira\", \"lima\", \"costa\", \"gomes\", \"almeida\", \"ribeiro\"];\r",
							"\r",
							"const primeiroNome = nomes[Math.floor(Math.random() * nomes.length)];\r",
							"const sobrenome = sobrenomes[Math.floor(Math.random() * sobrenomes.length)];\r",
							"const numero = Math.floor(Math.random() * 1000); // para garantir e-mails únicos\r",
							"\r",
							"const username = `${primeiroNome}.${sobrenome}${numero}`;\r",
							"const dominio = \"exemplo.com\";\r",
							"const email = `${username}@${dominio}`;\r",
							"\r",
							"// Gera uma senha baseada no username\r",
							"const senha = `${username}_@2025`;\r",
							"\r",
							"// Armazena em variáveis\r",
							"pm.environment.set(\"email_aleatorio\", email);\r",
							"pm.environment.set(\"senhaAleatoria\", senha);\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Email e senha foram enviados corretamente\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.email).to.eql(pm.environment.get(\"email_aleatorio\"));\r",
							"    // Valide mais conforme o comportamento da API\r",
							"});\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
